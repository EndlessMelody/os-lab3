#!/usr/bin/env python3
"""Local course-aligned Lab 3 checks; this is not the official course grader."""

import re
from pathlib import Path
from gradelib import *

evidence = Path('artifacts/lab3')
evidence.mkdir(parents=True, exist_ok=True)
r = Runner()


def boot(group, commands):
    maybe_unlink('fs.img')
    r.run_qemu(save(str(evidence / (group + '.txt'))),
               shell_script(commands), timeout=90)
    r.match(no=['PGTBL_FAIL:', 'panic:', r'usertrap\(', 'exec .* failed'])


@test(30, 'ugetpid')
def test_ugetpid():
    boot('ugetpid', ['pgtbltest ugetpid'])
    r.match('^ugetpid_test: OK$')


@test(30, 'vmprint')
def test_vmprint():
    boot('vmprint', ['echo PGTBL_BOOT_OK'])
    r.match(r'^page table 0x[0-9a-f]{16}$', '^PGTBL_BOOT_OK$')
    # Parse the complete init tree instead of assuming physical addresses or
    # a single stack page: this repository inherits two stack pages from Lab 1.
    tree = r.qemu.output.split('page table ', 1)[1].split('init: starting sh', 1)[0]
    rows = re.findall(r'^((?: \.\.){1,3})(\d+): pte (0x[0-9a-f]{16}) pa (0x[0-9a-f]{16})$',
                      tree, re.M)
    assert_equal(bool(rows), True, 'Missing formatted PTE rows')
    parents = []
    seen = set()
    leaves = {}
    previous = None
    for indent, index, pte, pa in rows:
        depth, index = indent.count('..'), int(index)
        pte, pa = int(pte, 16), int(pa, 16)
        assert_equal(0 <= index < 512 and bool(pte & 1), True)
        assert_equal(pa, (pte >> 10) << 12, 'PTE2PA mismatch')
        assert_equal(depth <= len(parents) + 1, True, 'Skipped a parent level')
        parents = parents[:depth - 1]
        path = tuple(parents + [index])
        assert_equal(path not in seen, True, 'Duplicate PTE')
        assert_equal(previous is None or previous < path, True, 'PTE traversal order')
        seen.add(path)
        previous = path
        if pte & 0xE:
            assert_equal(depth, 3, 'Expected 4 KiB leaf')
            leaves[path] = pte
        else:
            assert_equal(depth < 3, True, 'Non-leaf at final level')
            parents.append(index)
    assert_equal(len([p for p in leaves if p[:2] == (0, 0)]) >= 4, True)
    assert_equal((255, 511, 510) in leaves, True, 'Missing trapframe')
    assert_equal((255, 511, 511) in leaves, True, 'Missing trampoline')


